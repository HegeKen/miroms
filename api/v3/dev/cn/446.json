    "logs_zh": {
      "小米互传": [
        "新增 发送端显示“查看帮助”引导项"
      ],
      "系统": [
        "修复 小米兰亭PRO系统字体不能全局应用的问题",
        "提高移动网络下微信红包通知提示速度",
        "更新谷歌安全补丁（2020#01），提升系统安全性"
      ],
      "电话": [
        "修复 偶现来电时未显示电话接听界面的问题",
        "修复 偶现来电时锁屏不显示来电界面的问题",
        "修复 偶现挂断电话时界面卡住的问题"
      ],
      "应用锁": [
        "新增 应用锁新版首页及相关功能优化"
      ],
      "状态栏、通知栏": [
        "修复 偶现开机时状态栏变黑的问题",
        "修复 蓝牙电量图标显示异常的问题",
        "修复 状态栏的通知图标样式不统一、图标呈现黑块的问题",
        "修复 原生媒体通知专辑封面显示不全的问题",
        "修复 偶现锁屏下拉时，亮度条失效的问题",
        "修复 偶现横竖屏切换时通知栏时间变小的问题",
        "修复 收到日历通知后，息屏消失的问题",
        "修复 偶现通知栏无法显示来电通知的问题",
        "修复 “无线网络”快捷开关颜色浅的问题",
        "修复 偶现分身空间中不显示蓝牙设备剩余电量的问题",
        "修复 偶现横屏状态下无法收起通知栏的问题"
      ],
      "小爱同学": [
        "由于底层系统升级，小爱同学暂时下线声纹识别功能，并将语音唤醒功能移入小爱实验室，可前往“设置－小爱同学－小爱实验室”开启（小米CC9 Pro）"
      ],
      "省电优化": [
        "优化 低电量弹窗样式"
      ],
      "其他优化及调整": [
        "修复 不开深色模式，三方应用也被反色的问题（Redmi K20 Pro）",
        "修复 深色模式下VPN提示窗颜色不正确的问题"
      ]
    },
