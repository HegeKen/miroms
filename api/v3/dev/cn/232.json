  "logs": {
    "logs_zh": {
      "本周推荐": [
        "新增 通知管理新增三种通知管理方式：支持图标角标、通知铃声与震动、呼吸灯（设置>通知和状态栏>通知管理）",
        "新增 小米电台新增“已下载”模块，用于管理本地节目"
      ],
      "联系人": [
        "修复 从SIM卡导入联系人之后的一段时间内，在该联系人详情页进行操作可能导致 UI 显示错误的问题"
      ],
      "锁屏、状态栏、通知栏": [
        "新增 通知管理新增三种通知管理方式：支持图标角标、通知铃声与震动、呼吸灯（设置>通知和状态栏>通知管理）",
        "优化 恢复并优化“直接显示屏幕密码界面”的设置项",
        "优化 合上智能皮套时，新通知送达不自动点亮屏幕",
        "修复 设置中切换语言，导致系统崩溃的问题"
      ],
      "桌面": [
        "修复 某些情况下桌面图标重复的问题",
        "修复 时钟图标不显示的问题"
      ],
      "天气": [
        "优化 上下滑动易误判为左右滑动的问题",
        "修复 使用第三方字体导致天气温度排版错位的问题",
        "修复 首次打开天气应用，温度信息排版错误的问题"
      ],
      "设置": [
        "新增 护眼模式支持全局使用，可调屏幕效果（小米Note 4G TD / W / CDMA）"
      ],
      "应用商店": [
        "新增 应用升级页支持“忽略本次升级” （小米平板 ）",
        "新增 意见反馈功能（个人中心-设置-意见反馈）",
        "修复 某些情况下权限页闪退的问题",
        "修复 首页“推广”标志显示错误的问题"
      ],
      "日历": [
        "优化 日历小工具在开机后的启动时间"
      ],
      "语音助手": [
        "修复 某些情况下错误跳转至相机的问题"
      ],
      "小米生活": [
        "新增 抵用券功能（下单时可选择抵用券享受优惠）",
        "新增 积分功能（消费即可获得积分）"
      ],
      "电台": [
        "新增 “收听历史”的删除功能",
        "视频演示："
      ]
    }
  },
