  "logs": {
    "logs_zh": {
      "本周推荐": [
        "新增 远程协助全新上线，支持小米用户之间通过远程共享并控制屏幕的方式帮助对方解决问题",
        "新增 照片快速发现功能，1秒钟找到QQ、微信、微博等应用保存在相册的照片"
      ],
      "锁屏、状态栏、通知栏": [
        "修复 蓝牙耳机电量显示异常的问题"
      ],
      "主屏幕": [
        "优化 最近任务页允许上滑删除当前任务"
      ],
      "画廊": [
        "新增 照片快速发现功能，1秒钟找到QQ、微信、微博等应用保存在相册的照片"
      ],
      "天气": [
        "修复 从无数据到有数据的时候,异常提示不消失的问题",
        "修复 实时温度从无数据到有数据时字体变小的问题",
        "修复 二级页大图模糊的问题"
      ],
      "时钟/计算器": [
        "优化 个税计算器增加每个城市的最低生活保障数据作为计算公积金的参考值，公积金计算更精准"
      ],
      "远程协助": [
        "新增 远程协助全新上线，支持小米用户之间通过远程共享并控制屏幕的方式帮助对方解决问题"
      ]
    }
  },
