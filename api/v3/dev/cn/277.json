  "logs": {
    "logs_zh": {
      "本周推荐": [
        "新增 电脑向手机安装应用时进行安全提示，拦截不经用户允许，自动安装应用的行为",
        "新增 小米音乐增加听歌哼唱识别功能",
        "新增 小米音乐保存当前播放列表为歌单的功能"
      ],
      "短信": [
        "修复 短信红包显示的问题"
      ],
      "锁屏、状态栏、通知栏": [
        "修复 录指纹过程中，屏幕会超时锁屏的问题",
        "修复 锁屏收到通知后反复亮屏的问题",
        "删除 （出于安全考虑）锁屏界面能用小米账号“忘记密码”的功能"
      ],
      "图库": [
        "新增 相册支持置顶排序",
        "新增 任意相册均可云备份，包括微博、微信等文件夹内的图片",
        "新增 图库与系统主题适配",
        "新增 微信微博分享云相册",
        "新增 照片瘦身。云同步后智能瘦身本地照片，大幅节省系统空间90%以上"
      ],
      "音乐": [
        "新增 听歌哼唱识别功能",
        "新增 收藏内容通知提醒功能",
        "新增 拖拽调整播放列表歌曲顺序功能",
        "新增 保存当前播放列表到歌单功能",
        "新增 播放历史快捷入口"
      ],
      "备份": [
        "修复 某些情况下，一键换机在“选择应用页”内无响应的问题",
        "修复 传输文件名含“%”出错的问题"
      ],
      "授权管理": [
        "新增 电脑向手机安装应用时进行安全提示，拦截不经用户允许，自动安装应用的行为"
      ]
    }
  },
  "source": "miuiroms"
