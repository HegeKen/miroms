  "logs": {
    "logs_zh": {
      "本周推荐": [
        "新增 应用锁全新升级，支持指纹解锁"
      ],
      "系统": [
        "优化 微博点击图片显示速度"
      ],
      "短信": [
        "优化 短信无障碍使用体验。短信会话界面顶部右侧的回拨按钮，联系人详情按钮，底部短信内容编辑框左侧的添加附件按钮支持朗读。"
      ],
      "锁屏、状态栏、通知栏": [
        "修复 指纹录入过程无反馈的问题"
      ],
      "备份": [
        "修复 一键换机某些情况下传输中断、无响应的问题"
      ],
      "应用商店": [
        "新增 二级分类，分类浏览变得更高效",
        "优化 省电模式且不充电时，不检查更新和自动升级",
        "优化 应用详情页截图查看，支持点击放大浏览",
        "优化 卡片化样式全新改版，整体界面焕然一新"
      ],
      "权限管理器（Permissions Manager）是一种用于控制应用程序访问用户设备上各种资源（如文件、摄像头、麦克风等）的工具。它允许开发者为特定的应用程序设置访问权限，从而确保用户的数据安全和隐私得到保护。当用户安装新的应用程序时，权限管理器会提示该应用程序请求哪些权限；用户可以根据自己的需求决定是否批准这些请求。": [
        "优化 禁止获得读取通知权限的应用自启动"
      ],
      "米币中心": [
        "新增 全新米币中心首页",
        "优化 在支付的时候，手机充值卡，米币卡折叠到“米币”中",
        "优化 现在当您有第三方礼券的时候，会提示(优先使用)",
        "优化 现在出现小米账号错误时，会更准确地描述为小米账号错误",
        "优化 部分英文翻译",
        "优化 在Android M上能正确处理权限问题",
        "修复 米币中心解锁界面显示输入法的问题"
      ],
      "安全中心": [
        "新增 应用锁全新升级，支持指纹解锁"
      ],
      "小米钱包": [
        "新增 全新小米钱包收银台",
        "新增 支付支持小米金融分期付款",
        "优化 信用卡账单首页会显示标记信用卡的免息期长短",
        "修复 小米钱包的web页面能正确处理系统小米账号切换的问题",
        "修复 有时邮件服务器返回信息显示乱码的问题",
        "修复 验证用户邮箱出错时信息提示为null的问题",
        "修复 小米手机5上指纹支付偶尔会失败的问题",
        "修复 花旗银行信用卡账单无法解析的问题"
      ]
    }
  },
  "source": "miuiroms"
}