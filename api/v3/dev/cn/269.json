  "logs": {
    "logs_zh": {
      "本周推荐": [
        "新增 视频电话App 界面、图标全新改版，新增“动效”功能"
      ],
      "锁屏、状态栏、通知栏": [
        "优化 录入指纹的过程",
        "修复 电信副卡发送彩信时，状态栏不显示数据上下行的问题",
        "修复 锁屏后马上点击“返回键”或“菜单键”会重新唤醒屏幕的问题"
      ],
      "语音助手": [
        "修复 若干语音指令执行错误的问题"
      ],
      "视频电话": [
        "新增 神秘玩法亮相啦，试试通话中的“动效”玩法",
        "新增 3G/4G下自动省流量，1分钟视频只要2M",
        "新增 全新界面，全新图标",
        "优化 替换全新的铃声和回铃音",
        "优化 屏幕共享分辨率和流畅性提高",
        "优化 通话中支持静音",
        "优化 改善通话中的体验，如网络中断，网络质量差，锁屏等",
        "优化 去掉光感应，改进视频通话体验",
        "优化 呼叫时，如果对方不在线，快速提示",
        "优化 支持安卓6.0"
      ]
    }
  },
  "source": "miuiroms"
