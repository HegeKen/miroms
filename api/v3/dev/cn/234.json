    "logs_zh": {
      "本周推荐": [
        "新增 音乐新增“随便听听”，根据用户喜好个性化推荐歌曲",
        "新增 电话支持来电闪光灯（设置->电话->来电时状态设置中开启）"
      ],
      "电话": [
        "新增 支持来电闪光灯设置（设置->电话->来电时状态设置中开启）",
        "优化 网络电话的接听键图标"
      ],
      "联系人": [
        "修复 “联系人加入黑名单”功能消失的问题",
        "修复 编辑联系人时，从头像仓库选择头像后可能导致头像显示错误的问题",
        "修复 某些情况下，无法搜索联系人的问题"
      ],
      "短信": [
        "修复 飞行模式关闭后，未发送的短信无法自动发送的问题"
      ],
      "音乐": [
        "新增 根据用户喜好个性化推荐歌曲的模块：随便听听"
      ],
      "日历": [
        "修复 编辑提醒时可能造成日历停止运行的问题",
        "修复 退订日历后 UI 显示错误的问题"
      ],
      "米币中心": [
        "修复 有时使用支付宝充值会闪退的问题"
      ],
      "生活黄页": [
        "新增 特价机票专区",
        "新增 上海、长沙始发的部分客运站在线购票",
        "视频演示："
      ]
    }
  },
