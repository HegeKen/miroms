  "logs": {
    "logs_zh": {
      "本周推荐": [
        "新增 小米卡包界面全新改版，更多优惠与福利，还有神秘“发现”频道等你来 查看方式：设置->小米帐号->小米卡包",
        "新增 添加闹钟时，重复可选择“法定节假日”"
      ],
      "系统": [
        "优化 应用启动速度，划动流畅度",
        "优化 图片解码库，加快图片处理速度",
        "修复 移动数据网络切换到Wi-Fi时系统卡顿的问题"
      ],
      "备份": [
        "修复 某些情况下，一键换机在连接后停止运行的问题"
      ],
      "下载管理": [
        "新增 会员界面改版，支持更多会员套餐",
        "新增 “找资源”页全新改版，增加热门资源及网站收藏功能"
      ],
      "时钟/计算器": [
        "新增 添加“只响一次”闹钟时，可选择响铃后自动删除该闹钟",
        "新增 添加闹钟时，重复可选择“法定节假日”"
      ],
      "小米卡包": [
        "新增 小米卡包界面全新改版，更多优惠与福利，还有神秘“发现”频道等你来 查看方式：设置->小米帐号->小米卡包"
      ]
    }
  },
  "source": "miuiroms"
