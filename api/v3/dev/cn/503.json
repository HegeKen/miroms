  "logs": {
    "logs_zh": {
      "状态栏、通知栏": [
        "优化不重要通知收纳逻辑",
        "修复偶现不展示闹钟提醒等通知的异常",
        "修复长按通知偶现权限弹窗重叠的异常",
        "修复闹钟提醒通知的展示",
        "修复通知大小不一致的异常",
        "修复横屏状态下拉通知栏后，右上角出现小白点（设置图标）的异常",
        "优化通知过滤功能显示图标的逻辑",
        "优化不重要通知应用图标的显示异常"
      ],
      "系统": [
        "修复横屏开启小窗重启的问题",
        "修复思维笔记由于输入%导致乱码的问题",
        "修复概率性无线充电断充问题（小米9）",
        "新增隐身模式功能：开启隐身模式后所有应用将无法使用定位、相机、录音三项权限（Redmi Note 9 4G）",
        "修复来电时没有弹出电话界面的问题",
        "修复自动亮度调整过快的问题（小米11）",
        "优化控制中心WiFi二级页动画不流畅的问题",
        "优化控制中心下拉上滑不流畅的问题"
      ],
      "传送门": [
        "优化图片内文字识别能力，在保护用户隐私的前提下提供AI服务",
        "修复数字以及邮箱识别不准确",
        "修复加载动画显示异常",
        "修复图片文字识别结果顺序异常",
        "修复图片识别无文字时候显示重试"
      ],
      "小米相册": [
        "优化私密相册弹窗提示",
        "优化相册性能，修复若干问题，提升相册使用体验",
        "修复部分场景下相册图标读取错误的问题",
        "图片编辑新增2款滤镜：夏云、青春",
        "更新贴纸样式"
      ],
      "快应用服务框架": [
        "优化快应用「更多功能」弹窗的展示效果"
      ],
      "音乐": [
        "新增崩溃等异常的来源上报能力",
        "修复由于歌曲MV编解码与系统冲突导致的崩溃问题"
      ]
