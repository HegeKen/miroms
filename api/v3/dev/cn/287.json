  "logs": {
    "logs_zh": {
      "本周推荐": [
        "新增 “悬浮球”。在 MIUI 8发布会讲到的“悬浮球”功能，MIUI 7的用户也可以提前体验了。在“设置-更多设置-悬浮球” 中可以开启体验"
      ],
      "系统": [
        "优化 后台进程占用 CPU 资源导致卡顿的问题",
        "优化 某些情况下充电提示缓慢的问题",
        "修复 无线显示导致系统概率性重启的问题",
        "修复 个别屏幕护眼模式显示偏红的问题",
        "修复 某些情况下 GPS 功耗过高的问题",
        "修复 某些情况下开机时蓝牙自动打开的问题"
      ],
      "设置": [
        "新增 “悬浮球”。在 MIUI 8发布会讲到的“悬浮球”功能，MIUI 7的用户也可以提前体验了。在“设置-更多设置-悬浮球” 中可以开启体验"
      ],
      "小米云服务": [
        "新增 小米云手机备份新增立即备份功能。可以在刷机前及时备份桌面数据和系统设置，方便恢复"
      ]
    }
  },
