  "logs": {
    "logs_zh": {
      "系统": [
        "优化 Redmi K30 Pro 使用中屏幕卡顿的问题",
        "修复网络助手不能校准流量的问题",
        "修复经典版控制中心下拉后不能上滑的问题",
        "修复无障碍-听觉中音频均衡不能调节的问题",
        "优化通知中心的下拉动画",
        "优化通知角标的计数显示逻辑",
        "修复通知图标偶现错位的问题",
        "优化不重要通知的无障碍适配",
        "修复下拉通知中心出现闪屏的问题",
        "优化个别场景自动亮度",
        "修复解锁后壁纸拉伸的问题",
        "修复可以搜索到“连接到公共网络”但点击后无具体落地页",
        "修复WLAN详情页面部分控件talkback播报问题",
        "新增游戏中操作肩键可显示光效（Redmi K40 游戏增强版）",
        "修复隐私保护功能跳转时闪退的问题",
        "修复应用无申请权限时闪退的问题",
        "修复免提接听情况下，连接有线耳机时声音从免提发出的问题"
      ],
      "日历": [
        "修复部分影响体验的问题"
      ],
      "计算器": [
        "修复已知问题，提升应用稳定性"
      ],
      "小爱同学": [
        "新增 小爱设置页新增“小爱音量”，可以随时查看和调节小爱同学的回复声音大小",
        "新增 手机小爱支持语音远程控制小爱音箱啦，试着对我说“让音箱放首歌”",
        "新增 小爱同学支持一句话控制多个智能家居啦，比如你可以对我说：“打开灯和空调”",
        "新增 手机小爱支持免提呼叫，对小爱说“免提打电话给妈妈”"
      ],
      "设置": [
        "修复部分app无法在“账号与同步”中手动添加的问题"
      ],
      "时钟": [
        "优化闹钟响铃体验"
      ],
      "游戏服务": [
        "优化影响用户体验的问题"
      ]
