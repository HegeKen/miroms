  "logs": {
    "logs_zh": {
      "系统": [
        "优化 在锁屏闹钟页面屏蔽全面屏手势的功能（小米6X 、小米手机8SE、Redmi Note 8 Pro、小米手机8透明探索版）",
        "修复 在桌面解锁时偶现的黑屏闪烁问题",
        "修复 小米兰亭PRO系统字体不能全局应用的问题",
        "更新 谷歌安全补丁（2019#12），提升系统安全性",
        "更新 谷歌安全补丁（2020#01），提升系统安全性（红米S2）"
      ],
      "电话": [
        "修复 挂断电话时间与通话时长刷新不一致的问题（小米Play、红米手机6A、红米Note 5）"
      ],
      "应用锁": [
        "新增 应用锁新版首页及相关功能优化",
        "优化 应用锁验证页显示效果（小米手机8、小米MIX2S）",
        "修复 快速进入和关闭应用锁的时候状态栏异常问题（小米手机8、小米MIX2S）"
      ],
      "锁屏、状态栏、通知栏": [
        "新增 原生媒体通知样式（红米手机6Pro、小米手机6）",
        "新增 蓝牙、无线网络等快捷开关的等待开启动画",
        "新增 手机亮屏动画特效",
        "优化 允许正在运行的自定义媒体通知在锁屏上显示（红米手机6Pro、小米手机6）",
        "优化 锁屏、状态栏、通知栏的卡顿问题",
        "优化 混合密码解锁键盘样式",
        "修复 手机分身中，无法通过通知栏进入应用通知设置页的问题",
        "修复 个别应用的通知内容无法显示完整的问题（红米手机6Pro、小米手机6）",
        "修复 自定义快捷开关点击无反应、反应慢、首次打开不可点击等问题（红米手机6Pro、小米手机6）",
        "修复 偶现开机时状态栏变黑的问题",
        "修复 原生媒体通知专辑封面显示不全的问题",
        "修复 偶现锁屏下拉时，亮度条失效的问题",
        "修复 偶现通知栏变大错位的问题",
        "修复 媒体通知进度条与音乐进度不同步的问题",
        "修复 分身空间中快捷开关点按无效、异常的问题",
        "修复 偶现深色模式下状态栏图标颜色不一致的问题（小米6X、红米S2、小米MIX3、小米Note3）",
        "修复 偶现横竖屏切换时通知栏时间变小的问题",
        "修复 偶现通知栏无法显示来电通知的问题",
        "修复 “无线网络”快捷开关反应卡顿的问题",
        "修复 人脸解锁检测期间进入锁屏负一屏再返回锁屏时，人脸检测关闭的问题",
        "修复 蓝牙电量图标显示异常的问题",
        "修复 “无线网络”快捷开关颜色浅的问题",
        "修复 偶现分身空间中不显示蓝牙设备剩余电量的问题",
        "修复 偶现横屏状态下无法收起通知栏的问题"
