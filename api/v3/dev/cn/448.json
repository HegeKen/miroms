    "logs_zh": {
      "系统": [
        "更新谷歌安全补丁（2020#02），提升系统安全性",
        "新增 壁纸智能压暗，解决锁屏、桌面文字不易看清的问题"
      ],
      "小米互传": [
        "新增 将发送过的设备，在短时间内置顶显示的功能"
      ],
      "锁屏": [
        "修复 挂断电话后，锁屏偶现黑屏的问题"
      ],
      "相机": [
        "优化 视频录制中稳定器变焦的流畅性（小米10、小米10 Pro）",
        "修复 专业视频光焦分离后偶现不稳定的问题（小米10 Pro）"
      ],
      "小爱同学": [
        "修复 某些情况下小爱同学不能唤醒的问题（小米10）"
      ],
      "其他": [
        "优化 扬声器音质优化，提升中音量音质体验（小米10）",
        "修复 某些场景下UC浏览器无响应的问题（小米9Pro 5G、小米9、Redmi K20 Pro ）",
        "修复 偶现换机失败的问题"
      ]
    }
  },
