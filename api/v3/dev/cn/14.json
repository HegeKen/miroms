    "logs_zh": {
      "推荐功能": [
        "1.Milestone 桌面内存占用减少、支持丽音设置、支持OTA升级。",
        "超绚丽新版音乐，好听好用。"
      ],
      "短信": [
        "优化 对单条短信的长按操作。"
      ],
      "联系人": [
        "优化 联系人分组显示和编辑模式。",
        "优化 座机区分家庭座机和办公座机。"
      ],
      "桌面": [
        "新增 换主题的桌面快捷入口。",
        "优化 换主题的操作流程。",
        "优化 图形电量模式下，充电显示小闪电。",
        "修复 选壁纸可以看到主题壁纸。"
      ],
      "其它": [
        "系统兼容性：",
        "修复 gmail图标消失问题",
        "修复 Messaging Widgets 1.5.3",
        "修复 Multipicture Wallpaper"
      ],
      "Milestone": [
        "新增 支持丽音设置。",
        "新增 支持OTA升级。",
        "修复 返回桌面，桌面会再次刷新的问题。",
        "修复 解锁后屏幕唤醒太慢的问题。",
        "修复 联接USB后，有两个USB弹出的问题。",
        "修复 默认设置为不超频。",
        "修复 桌面内存占用问题。",
        "修复 截屏图片颜色变色的问题。"
      ],
      "网盘": [
        "新增 网盘及OTA升级支持断点续传。",
        "新增 网盘下载管理页面。"
      ],
