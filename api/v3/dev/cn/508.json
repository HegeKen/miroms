  "logs": {
    "logs_zh": {
      "系统": [
        "修复侧滑返回手势震动消失的问题",
        "修复进入密码输入页面，人脸与指纹同时检测解锁时有概率出现崩溃的问题",
        "修复分身空间导致的悬浮通知异常闪烁的问题",
        "修复部分场景下控制中心亮度条失效的问题",
        "修复播放音乐时，通知栏偶现不显示媒体控制面板的问题",
        "修复虚拟按键出现反色异常的问题",
        "修复部分机型剩余存储，从小于10%增加到大于10%时无法使用“内存扩展”功能的问题"
      ],
      "AI工具箱": [
        "新增AI翻译功能"
      ],
      "智能助理（负一屏）": [
        "新增小米商城816活动卡片"
      ],
      "扫一扫": [
        "修复小爱跳转问题"
      ],
      "小米相册": [
        "新增图片列表中删除或新增图片后的补位动画",
        "新增4款图片编辑滤镜：半夏、若草、落日、食新",
        "优化相册性能，修复若干问题，提升相册使用体验"
      ],
      "小爱同学": [
        "新增小爱现在可以在锁屏下查询闹钟、日程啦，前往解锁设置打开“查询闹钟日程”开关就可以实现哦",
        "修复小爱翻译支持添加到桌面快捷方式，对小爱说“打开翻译”试一试"
      ]
    }
  },
