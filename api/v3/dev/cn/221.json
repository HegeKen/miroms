      "系统": [
        "修复 系统一和系统二上显示可用内存区别较大的问题"
      ],
      "锁屏、状态栏、通知栏": [
        "新增 锁屏新增右滑呼出智能家居控制中心",
        "优化 息屏状态下，当新通知送达时，屏幕自动点亮",
        "优化 锁屏界面的UI设计，优化新通知送达时的动画效果和显示位置",
        "优化 锁屏下左滑呼出相机的动画效果",
        "优化 更换了拨掉数据线时的音效",
        "修复 双卡机型使用两张卡的情况下，只显示一个信号塔的问题",
        "修复 有锁屏密码的情况下，可从智能家居控制中心直接进入桌面的问题"
      ],
      "桌面": [
        "优化 桌面便签小插件支持显示富文本格式"
      ],
      "音乐": [
        "优化 在线播放的性能，缓冲更快，播放更稳定"
      ],
      "天气": [
        "修复 实时温度不在预报范围内的问题"
      ],
      "网络助手": [
        "新增 支持广东移动用户通过小米支付购买流量包"
      ],
