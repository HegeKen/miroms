  "logs": {
    "logs_zh": {
      "系统": [
        "修复不重要通知到达时亮屏和响铃的问题",
        "修复通知中心偶现透明及高斯模糊的问题",
        "修复音乐通知删除后又自动加载的问题",
        "修复抬起亮屏功能失效的问题",
        "修复调整字体粗细后，重启手机失效的问题",
        "修复通知栏部分应用不显示通知的问题",
        "修复控制中心移动数据开关，运营商名称变为英文的问题",
        "修复不重要通知长按跳转异常的问题",
        "修复高刷新率情况下，设置部分页面操作卡顿的问题",
        "修复部分APP帐号，无法同步到“帐号与同步”中的问题",
        "修复系统休眠时无法点亮指纹图标问题（小米CC9）"
      ],
      "智能助理（负一屏）": [
        "新增天星金融服务卡片"
      ],
      "音乐": [
        "新增崩溃等异常的来源上报能力",
        "修复由于歌曲MV编解码与系统冲突导致的崩溃问题",
        "新增歌曲MV功能，想听想看都可以",
        "新增VIP歌曲试听功能，听听副歌也不错"
      ],
      "小米视频": [
        "新增全网筛选和搜索功能",
        "新增豆瓣榜单、豆瓣评分和豆瓣短评",
        "新增全网电影、电视剧、综艺、纪录片榜单"
      ],
      "设置": [
        "修复专注模式异常退出问题"
      ]
    }
  },
