    "logs_zh": {
      "电话": [
        "优化 盲人使用体验：双卡的拨号按钮朗读会区分卡1和卡2，开拨号盘的按钮支持朗读"
      ],
      "联系人": [
        "优化 盲人使用体验：详情页发短信按钮朗读时会有具体号码，头像区域支持朗读和voip的语音、视频通话按钮支持朗读"
      ],
      "锁屏、状态栏、通知栏": [
        "修复 电源键菜单在盲人模式下无法被朗读和操作的问题"
      ],
      "桌面": [
        "修复 重启后第一次打开自由桌面的文件夹，提示修改文件夹名字的问题"
      ],
      "网络助手": [
        "优化 当月流量首次超出后，如果用户修改套餐，再次超出时仍会断网"
      ]
    }
