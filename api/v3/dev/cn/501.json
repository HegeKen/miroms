  "logs": {
    "logs_zh": {
      "系统": [
        "修复淘宝、微博APP部分场景下卡顿的问题",
        "修复个别应用在使用指纹验证时，跳回到锁屏界面的问题",
        "修复深色模式下应用商店显示斑马线的问题",
        "修复部分场景下拨打电话，没有过渡动画的问题",
        "增加应用内刘海设置",
        "修复状态栏信号图标间距较大的问题",
        "修复天气城市列表滑动掉帧的问题（小米10）",
        "优化背部轻敲功能，解决了部分灵敏度问题（Redmi K40 Pro）"
      ],
      "状态栏、通知栏": [
        "修复通知点击延时提醒后出现的闪屏问题",
        "修复透明背景悬浮通知显示重叠",
        "修复通知中心下拉失效的问题",
        "优化来电的悬浮通知屏蔽逻辑",
        "优化组通知展开收起的动画",
        "修复通知滑动时的圆角展示异常",
        "优化通知栏深色模式显示"
      ],
      "录音机": [
        "修复一些已知问题，提升应用稳定性"
      ]
    }
  },
