  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "已加入防回刷机制的机型无法降级刷回旧版本的开发版或稳定版，否则会导致手机变砖",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可进入“设置→我的设备→MIUI版本”在线升级",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户，建议通过线刷升级至 MIUI 10开发版，教程请见下方“刷机指南”",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI 开发版 9.5.16 已发布；部分机型发布9.5.17",
          "en-us": ""
        },
        {
          "zh-cn": "已升级 Android P 的小米6用户，不建议回刷版本，因底层版本不同，可能出现功能异常等问题；从 Android P 回刷至 Android O, 若出现查找手机、指纹支付等异常问题，需先刷入过渡的线刷包，再刷 Android O 版本即可正常使用。",
          "en-us": ""
        },
        {
          "zh-cn": "小米MIX 2已发布公测",
          "en-us": ""
        },
        {
          "zh-cn": "小米9已发布公测",
          "en-us": ""
        },
        {
          "zh-cn": "Redmi Note 7 Pro 已发布公测",
          "en-us": ""
        },
        {
          "zh-cn": "小米MIX 2S/小米8/透明探索版/青春版/屏幕指纹版/小米MIX 3已发布公测版本9.5.17",
          "en-us": ""
        },
        {
          "zh-cn": "小米9 SE因排查月亮模式下拍照绿屏的问题，为避免影响使用，暂停公测发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米Note3 本周发布最后一个 Android O 版本，预计6月初启动Android P内测",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可点击“设置”→“我的设备”→“MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户版本用户建议通过线刷升级，线刷会清除全部数据",
          "en-us": ""
        },
        {
          "zh-cn": "开发版/稳定版相互刷机时，需备份好重要数据，再通过线刷方式清除所有数据进行刷机，防止出现异常问题",
          "en-us": ""
        },
        {
          "zh-cn": "新机型有防刷机保护，线刷前请先进行 Bootloader 解锁",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第416周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "应用锁",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 支持设置隐私应用，隐藏应用桌面图标",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "锁屏、状态栏、通知栏",
          "en-us": "Lockscreen, Status Bar, Notification Bar",
          "changes": [
            {
              "zh-cn": "优化 屏下指纹的解锁速度",
              "en-us": "Optimization: In-screen fingerprint scanner's response"
            },
            {
              "zh-cn": "修复 横屏状态下，锁屏密码提示语显示不完整的问题",
              "en-us": "Fixed an issue where the lock screen password hint was displayed incompletely in landscape mode"
            },
            {
              "zh-cn": "修复 电量与充电图标显示异常问题",
              "en-us": "Fix abnormal display of battery and charging icons"
            }
          ]
        },
        {
          "zh-cn": "相机",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 相机滤镜效果",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "游戏加速",
          "en-us": "Game speed booster",
          "changes": [
            {
              "zh-cn": "新增 进入游戏禁止下拉通知栏功能",
              "en-us": "New: You can restrict opening Notification shade while playing games"
            },
            {
              "zh-cn": "支持单独设置进入游戏关闭自动亮度、三指截图、护眼模式",
              "en-us": "Auto brightness, screenshot gestures, and Reading mode can be turned off automatically when Game Turbo is on"
            }
          ]
        }
      ]
    }
  ]
}