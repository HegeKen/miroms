  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI 开发版可进入“设置—>我的设备—>MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI 12.5 开发版21.9.22 版本 今天陆续发布，部分机型已发布",
          "en-us": ""
        },
        {
          "zh-cn": "由于Android大版本升级，小米11 Ultra、小米11 Pro、小米11、Redmi K40 Pro 2021年9月6日起暂停发布公测，小米11 青春版、Redmi K40、小米10S 2021年9月22日起暂停发布公测，在内测周度参与标准中，大家可对正在使用的版本投票和发布体验贴，感谢大家的理解",
          "en-us": ""
        },
        {
          "zh-cn": "开发版内测版本问题逐步修复后，会陆续推送开发版公测版本，安卓12已知问题，",
          "en-us": ""
        },
        {
          "zh-cn": "点此查看>>",
          "en-us": ""
        },
        {
          "zh-cn": "为给米粉朋友们，相对更好的测试版本使用体验，近期发版计划如下，提前祝大家国庆快乐",
          "en-us": ""
        },
        {
          "zh-cn": "①. 9月27日-9月29日：开发版内测正常发布",
          "en-us": ""
        },
        {
          "zh-cn": "②. 9月30日-10月10日：开发版内测、开发版公测暂停发布",
          "en-us": ""
        },
        {
          "zh-cn": "③. 10月11日（周一）：开发版内测、开发版公测恢复发布",
          "en-us": ""
        },
        {
          "zh-cn": "2021年11月27日起，以下机型将停止开发版内测公测：小米9、小米9SE、Redmi K20 Pro、Redmi K20、小米CC9 美图定制版、Redmi Note 8 Pro、小米CC9、Redmi Note 8、小米9 Pro",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第514周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复灭屏下快速指纹解锁成功后，不进入桌面的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复在画报详情界面时，下拉控制中心通知会显示指纹图标的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复锁屏负一屏背景颜色取色不正确，导致显示全白页面的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复使用错误指纹解锁，第五次无提示语的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复偶现应用锁界面灭屏，按压电源键亮屏，指纹解锁无反应的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复灭屏下长按指纹触发快捷功能后，弹出图标过程抖动闪屏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复锁屏状态下启动相机，下拉通知栏点击通知后，图案解锁页面无法向左滑动的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复有悬浮通知时从桌面下拉通知栏，悬浮通知不消失的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复悬浮通知上方圆角不平滑的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复使用三方主题时，横屏下拉通知栏无法全屏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复媒体通知无法左右滑动切换的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复息屏图案显示模糊的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复有悬浮通知时，底部出现白框的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "主屏幕",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "小部件功能焕然一新，新小部件可添加至负一屏与桌面，并支持相互拖拽",
              "en-us": ""
            },
            {
              "zh-cn": "小部件中心，提供丰富的小部件资源 「双指捏合桌面即可进入」",
              "en-us": ""
            },
            {
              "zh-cn": "时钟、天气、相册等系统应用小部件",
              "en-us": ""
            },
            {
              "zh-cn": "负一屏内卡片支持自由拖拽排序",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "画廊",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增图片列表中删除或新增图片后的补位动画，大幅优化动画体验",
              "en-us": ""
            },
            {
              "zh-cn": "新增照片页快速切换控件，可在【全部】和【相机】之间进行快速切换，查找内容更方便快捷，还能记住你的喜好",
              "en-us": ""
            },
            {
              "zh-cn": "新增照片和视频数量显示，照片页下拉即可轻松发现",
              "en-us": ""
            },
            {
              "zh-cn": "优化相册分类，将屏幕录制与截屏相册合并，提升查找效率",
              "en-us": ""
            },
            {
              "zh-cn": "优化相册编辑-裁切旋转图标，提升使用效率",
              "en-us": ""
            }
          ]
        }
      ]
    }
  ]
}