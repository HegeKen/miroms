  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "已加入防回刷机制的机型无法降级刷回旧版本的开发版或稳定版，否则会导致手机变砖",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可进入“设置→我的设备→MIUI版本”在线升级",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户，建议通过线刷升级至 MIUI 10开发版，教程请见下方“刷机指南”",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI10 开发版 9.5.23 部分机型本周暂停发布",
          "en-us": ""
        },
        {
          "zh-cn": "已升级 Android P 的小米6用户，不建议回刷版本，因底层版本不同，可能出现功能异常等问题；从 Android P 回刷至 Android O, 若出现查找手机、指纹支付等异常问题，需先刷入过渡的线刷包，再刷 Android O 版本即可正常使用。",
          "en-us": ""
        },
        {
          "zh-cn": "红米6A、红米6、小米平板4、小米平板4 Plus、小米PLAY、红米6 Pro因测试系统稳定性本周暂停发布公测",
          "en-us": ""
        },
        {
          "zh-cn": "小米8、小米9 SE因处理开启DC调光后屏幕闪烁问题本周暂停发布公测",
          "en-us": ""
        },
        {
          "zh-cn": "小米8透明探索版、小米8屏幕指纹版、小米8 SE、小米MIX 3、小米9、小米MIX 2S 因排查闹钟是否正常关闭问题本周暂停发布公测",
          "en-us": ""
        },
        {
          "zh-cn": "小米Note3 因适配 Android P，暂停公测发布",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可点击“设置”→“我的设备”→“MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户版本用户建议通过线刷升级，线刷会清除全部数据",
          "en-us": ""
        },
        {
          "zh-cn": "开发版/稳定版相互刷机时，需备份好重要数据，再通过线刷方式清除所有数据进行刷机，防止出现异常问题",
          "en-us": ""
        },
        {
          "zh-cn": "新机型有防刷机保护，线刷前请先进行 Bootloader 解锁",
          "en-us": ""
        }
      ]
    }
  ],
