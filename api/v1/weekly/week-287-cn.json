      "log": [
        {
          "zh-cn": "本周推荐",
          "en-us": "本周推荐",
          "changes": [
            {
              "zh-cn": "新增 “悬浮球”。在 MIUI 8发布会讲到的“悬浮球”功能，MIUI 7的用户也可以提前体验了。在“设置-更多设置-悬浮球” 中可以开启体验",
              "en-us": "新增 “悬浮球”。在 MIUI 8发布会讲到的“悬浮球”功能，MIUI 7的用户也可以提前体验了。在“设置-更多设置-悬浮球” 中可以开启体验"
            }
          ]
        },
        {
          "zh-cn": "系统",
