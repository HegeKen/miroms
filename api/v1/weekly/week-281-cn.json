  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI V5 / MIUI 6开发版可以直接 OTA 升级（方法：系统更新 - 检查更新 - 选择最新版本升级）",
          "en-us": ""
        },
        {
          "zh-cn": "较老版本的 MIUI 可通过刷 MIUI V5 / MIUI 6 / MIUI 7 最新完整包快速升级（方法：小米手机可通过系统更新 - Menu - 选择安装包进行升级，第三方机型需手动进入 Recovery 选择完整包进行升级）",
          "en-us": ""
        },
        {
          "zh-cn": "跨版本进行升级时（如稳定版刷开发版）需要清除所有数据，以避免因数据冲突出现个例问题；清除数据前务必主动备份数据，以免丢失（方法：设置 - 备份和重置 - 本地备份）",
          "en-us": ""
        },
        {
          "zh-cn": "其它品牌手机首次刷 MIUI ROM 请严格按照刷机教程进行刷机",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI7 6.4.7 已发布！",
          "en-us": ""
        },
        {
          "zh-cn": "红米Note 3 全网通发布6.4.9版本，修复某些情况下，浏览器闪退以及6.4.8版本内存资源占用过大的问题",
          "en-us": ""
        }
      ]
    }
  ],
