  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI 11开发版可进入“设置—>我的设备—>MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI11 开发版9.12.12 11:00发布，部分机型延迟发布",
          "en-us": ""
        },
        {
          "zh-cn": "Redmi Note 8 Pro 发布第一个基于Android 10 的 MIUI 开发版, 多项优化与改进, 向勇敢尝鲜的米粉们致敬!",
          "en-us": ""
        },
        {
          "zh-cn": "小米8 青春版、小米MAX3 启动Android 10升级，本周暂停发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米PLAY、小米9 Pro 5G、小米CC 9Pro、小米8 SE、小米8屏幕指纹版、小米MIX 2S、小米8、小米8透明探索版、小米MIX 3 因测试系统稳定性，公测发布延迟",
          "en-us": ""
        },
        {
          "zh-cn": "Redmi Note 8、小米CC9、Redmi K20 Pro、小米9 因解决影响稳定性Bug，本周暂停发布",
          "en-us": ""
        },
        {
          "zh-cn": "红米Note 4X 、红米4X、红米Note 5A标准版、红米Note 5A高配版、小米5C、小米Max 2、小米Note 2、小米MIX、小米手机5s、小米手机5s Plus 、红米5 Plus、小米5X、红米5A、红米5、小米平板3 正式停止开发版公测",
          "en-us": ""
        },
        {
          "zh-cn": "由于不在MIUI11适配计划机型内，小米平板4/4Plus暂停更新",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第441周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "其他",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "系统",
              "en-us": ""
            },
            {
              "zh-cn": "新增 添加蓝牙LHDC的编码格式支持（小米手机9、Redmi K20 Pro）",
              "en-us": ""
            },
            {
              "zh-cn": "修复 小米兰亭PRO系统字体不能全局应用的问题",
              "en-us": ""
            },
            {
              "zh-cn": "锁屏、状态栏、通知栏",
              "en-us": ""
            },
            {
              "zh-cn": "新增 手机亮屏动画特效",
              "en-us": ""
            },
            {
              "zh-cn": "新增 灭屏变暗的动画效果（ 小米手机9Pro 5G、小米手机9、小米MIX2、小米手机6、Redmi K20 Pro）",
              "en-us": ""
            },
            {
              "zh-cn": "修复 人脸解锁检测期间进入锁屏负一屏再返回锁屏时，人脸检测关闭的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 使用错误指纹连续解锁五次以上不显示错误提示",
              "en-us": ""
            },
            {
              "zh-cn": "修复 蓝牙电量图标显示异常的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 使用图案密码切换分身空间时，偶现系统无法响应的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 开启护眼模式后按压电源键锁屏，护眼模式先失效后息屏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 “无线网络”快捷开关反应卡顿的问题",
              "en-us": ""
            },
            {
              "zh-cn": "时钟",
              "en-us": ""
            },
            {
              "zh-cn": "新增 作息管理功能",
              "en-us": ""
            },
            {
              "zh-cn": "省电优化",
              "en-us": ""
            },
            {
              "zh-cn": "新增 省电模式新增多项优化，如：关闭触控反馈，抬起唤醒等",
              "en-us": ""
            }
          ]
        }
      ]
    }
