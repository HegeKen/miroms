  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI V5 / MIUI 6开发版可以直接 OTA 升级（方法：系统更新 - 检查更新 - 选择最新版本升级）",
          "en-us": ""
        },
        {
          "zh-cn": "较老版本的 MIUI 可通过刷 MIUI V5 / MIUI 6 最新完整包快速升级（方法：小米手机可通过系统更新 - Menu - 选择安装包进行升级，第三方机型需手动进入 Recovery 选择完整包进行升级）",
          "en-us": ""
        },
        {
          "zh-cn": "跨版本进行升级时（如稳定版刷开发版）需要清除所有数据，以避免因数据冲突出现个例问题；清除数据前务必主动备份数据，以免丢失（方法：设置 - 备份和重置 - 本地备份）",
          "en-us": ""
        },
        {
          "zh-cn": "其它品牌手机首次刷 MIUI ROM 请严格按照刷机教程进行刷机",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI6 5.4.10 已发布！",
          "en-us": ""
        },
        {
          "zh-cn": "本周红米1S W/C版正式公测，升级前请先更新至最新稳定版JHCCNBL50.0，卡刷之前请先备份数据，再清除全部数据刷入",
          "en-us": ""
        },
        {
          "zh-cn": "红米1S W/C 使用非原厂电池的发烧友，重启后可能会有跳电的现象，工程师正在跟进中",
          "en-us": ""
        },
        {
          "zh-cn": "收到部分反馈，红米1S W/C 使用过程中会出现基带丢失的问题，我们正在排查问题中",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第232周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "本周推荐",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 通知管理新增三种通知管理方式：支持图标角标、通知铃声与震动、呼吸灯（设置>通知和状态栏>通知管理）",
              "en-us": ""
            },
            {
              "zh-cn": "新增 小米电台新增“已下载”模块，用于管理本地节目",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "联系人",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复 从SIM卡导入联系人之后的一段时间内，在该联系人详情页进行操作可能导致 UI 显示错误的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "锁屏、状态栏、通知栏",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 通知管理新增三种通知管理方式：支持图标角标、通知铃声与震动、呼吸灯（设置>通知和状态栏>通知管理）",
              "en-us": ""
            },
            {
              "zh-cn": "优化 恢复并优化“直接显示屏幕密码界面”的设置项",
              "en-us": ""
            },
            {
              "zh-cn": "优化 合上智能皮套时，新通知送达不自动点亮屏幕",
              "en-us": ""
            },
            {
              "zh-cn": "修复 设置中切换语言，导致系统崩溃的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "桌面",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复 某些情况下桌面图标重复的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 时钟图标不显示的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "天气",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 上下滑动易误判为左右滑动的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 使用第三方字体导致天气温度排版错位的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 首次打开天气应用，温度信息排版错误的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "设置",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 护眼模式支持全局使用，可调屏幕效果（小米Note 4G TD / W / CDMA）",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "应用商店",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 应用升级页支持“忽略本次升级” （小米平板 ）",
              "en-us": ""
            },
            {
              "zh-cn": "新增 意见反馈功能（个人中心-设置-意见反馈）",
              "en-us": ""
            },
            {
              "zh-cn": "修复 某些情况下权限页闪退的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 首页“推广”标志显示错误的问题",
