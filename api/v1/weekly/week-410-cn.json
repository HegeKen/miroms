        {
          "zh-cn": "锁屏、状态栏、通知栏",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 状态栏GPS图标显示",
              "en-us": ""
            },
            {
              "zh-cn": "优化 人脸解锁的流程",
              "en-us": ""
            },
            {
              "zh-cn": "修复 解锁进入横屏界面时有异常闪亮的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 横屏状态下未及时展示低电量悬浮通知的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 锁屏通知栏双重显示问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 个别情况下人脸提示未及时消失的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "设置",
          "en-us": "",
          "changes": [
