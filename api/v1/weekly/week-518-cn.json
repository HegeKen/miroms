  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI 开发版可进入“设置—>我的设备—>MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI 12.5 开发版 21.10.20 版本 今天陆续发布，部分机型已发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米11 青春版 首次发布开发版, 多项优化与改进, 向勇敢尝鲜的米粉们致敬",
          "en-us": ""
        },
        {
          "zh-cn": "由于Android大版本升级，小米MIX 4、Redmi K40 游戏增强版、Redmi Note 10 Pro 2021年10月29日起暂停发布公测，在内测周度参与标准中，大家可对正在使用的版本投票和发布体验贴，感谢大家的理解",
          "en-us": ""
        },
        {
          "zh-cn": "由于Android大版本升级，Redmi K40、小米10S 2021年9月22日起暂停发布公测，预计10月29日恢复发布公测，在内测周度参与标准中，大家可对正在使用的版本投票和发布体验贴，感谢大家的理解",
          "en-us": ""
        },
        {
          "zh-cn": "开发版内测版本问题逐步修复后，会陆续推送开发版公测版本，安卓12已知问题，",
          "en-us": ""
        },
        {
          "zh-cn": "点此查看>>",
          "en-us": ""
        },
        {
          "zh-cn": "为给米粉朋友们相对更好的使用体验，小米10 Pro、小米10、Redmi K30 Pro、小米10 至尊纪念版、Redmi K30S 至尊纪念版、小米平板5 Pro、小米平板5 Pro 5G 预计10月24日24点前发布21.10.21版本，对QQ、微信、支付宝等APP打开慢、微信视频通话对方听不到声音问题部分优化，感谢米粉朋友的理解",
          "en-us": ""
        },
        {
          "zh-cn": "2021年11月27日起，以下机型将停止开发版内测公测：小米9、小米9SE、Redmi K20 Pro、Redmi K20、小米CC9 美图定制版、Redmi Note 8 Pro、小米CC9、Redmi Note 8、小米9 Pro",
          "en-us": ""
        },
        {
          "zh-cn": "如大家遇到无法获取设备ID和笔记云同步异常的问题，",
          "en-us": ""
        },
        {
          "zh-cn": "请点此查看>>",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第518周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化安卓12开发版，部分场景重启的问题（小米11、小米11 Pro、小米11 Ultra、Redmi K40 Pro）",
              "en-us": ""
            },
            {
              "zh-cn": "优化安卓12开发版，来悬浮通知后全屏变暗的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复长按通知栏通知显示错位的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复通知栏通知卡片显示大小不一致的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复偶现接收短信通知时背景变黑的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复偶现上滑进入输入密码页闪黑的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复使用蓝牙解锁无提示的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复关闭锁屏时可下拉通知栏，仍可在锁屏后下拉通知栏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复WhatsApp不显示悬浮通知的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复三方主题下，收到悬浮通知时全屏显示通知栏背景的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复三方主题下，锁屏通知显示重叠的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "桌面",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化桌面主屏幕与外部屏幕布局方式，统一图标个数，整理桌面更高效（MIX FOLD）",
              "en-us": ""
            },
            {
              "zh-cn": "优化桌面图标加载机制，使用体验更丝滑（MIX FOLD）",
              "en-us": ""
            },
            {
              "zh-cn": "修复内外屏翻折显示错误、快切闪烁、云备份等已知问题（MIX FOLD）",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "锁屏",
          "en-us": "",
