      "details": [
        {
          "zh-cn": "MIUI11 开发版 9.10.10 11:00发布，部分机型延迟发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米9 SE、Redmi K20、小米8、小米8屏幕指纹版、小米8透明探索版、小米MIX 2S、小米MIX 3 准备启动Android 10升级，本周暂停发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米8 SE 准备启动Android 10升级，本周发布最后一个P版本",
          "en-us": ""
        },
        {
          "zh-cn": "小米PLAY、Redmi Note 7、小米9、Redmi K20 Pro、红米6、小米CC 9e 因测试系统稳定性，公测发布延迟",
          "en-us": ""
        },
        {
          "zh-cn": "红米Note 4X 、红米4X、红米Note 5A标准版、红米Note 5A高配版、小米5C、小米Max 2、小米Note 2、小米MIX、小米手机5s、小米手机5s Plus 、红米5 Plus、小米5X、红米5A、红米5 停版日期在节假日中，顺延一周再停版，本周发布最后一个开发版",
          "en-us": ""
        },
        {
          "zh-cn": "小米平板3即日起正式停止开发版公测",
          "en-us": ""
        }
      ]
    }
