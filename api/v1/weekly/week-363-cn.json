  "logs": [
    {
      "zh-cn": "第363周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "本周推荐",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 扬声器声音内录，录屏时可选择录制手机扬声器发出的内置声音",
              "en-us": ""
            },
            {
              "zh-cn": "新增 冲印功能，把照片变成可以拿在手上的照片书",
              "en-us": ""
            },
            {
              "zh-cn": "优化 优化游戏中短信、微信、QQ消息提醒样式，减小对游戏过程的干扰",
              "en-us": ""
            },
            {
              "zh-cn": "优化 横屏全屏时悬浮通知的样式",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 横屏全屏时悬浮通知的样式",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "电话",
          "en-us": "",
          "changes": [
