  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "已加入防回刷机制的机型无法降级刷回旧版本的开发版或稳定版，否则会导致手机变砖",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可进入“设置→我的设备→MIUI版本”在线升级",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户，建议通过线刷升级至 MIUI 10开发版，教程请见下方“刷机指南”",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI10 开发版 9.2.28 已发布",
          "en-us": ""
        },
        {
          "zh-cn": "红米5A/红米5/红米5 Plus/小米5X/红米Note 5/红米6A/红米6/红米6 Pro/小米Play/红米Note 7/小米8 SE/小米8 青春版/小米8 屏幕指纹版/小米Max 3/小米8 已发布公测版本号9.3.1",
          "en-us": ""
        },
        {
          "zh-cn": "小米手机6X本周发布最后一个Android O公测版本9.3.1，预计在3月中旬启动安卓P内测",
          "en-us": ""
        },
        {
          "zh-cn": "小米8 透明探索版已发布公测版本号9.3.4",
          "en-us": ""
        },
        {
          "zh-cn": "红米S2本周发布最后一个Android O公测版本9.2.28，预计在3月底启动安卓P内测",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI于2019年3月1日发布小米Max、小米Max 高配版最后一个开发版9.2.28，两款机型将不再支持后续的版本升级。同时我们也准备了稳定版的升级方案，米粉可根据需求选择继续停留开发版或预约升级至后续的MIUI 10.3稳定版（预计4月份发布）",
          "en-us": ""
        },
        {
          "zh-cn": "Android O/P机型招募开发版内测米粉",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可点击“设置”→“我的设备”→“MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户版本用户建议通过线刷升级，线刷会清除全部数据",
          "en-us": ""
        },
        {
          "zh-cn": "开发版/稳定版相互刷机时，需备份好重要数据，再通过线刷方式清除所有数据进行刷机，防止出现异常问题",
          "en-us": ""
        },
        {
          "zh-cn": "新机型有防刷机保护，线刷前请先进行 Bootloader 解锁",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第407周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "桌面",
          "en-us": "Home screen",
          "changes": [
            {
              "zh-cn": "修复 WhatsApp 桌面角标显示异常的问题",
              "en-us": "Fix: Notification badges were displayed incorrectly on the WhatsApp icon"
            }
          ]
        },
        {
          "zh-cn": "游戏加速",
          "en-us": "Game speed booster",
          "changes": [
            {
              "zh-cn": "新增 电话悬浮窗功能，支持游戏中接通的电话使用悬浮窗显示接通状态",
              "en-us": "New: Floating windows for incoming calls during games"
            },
            {
              "zh-cn": "新增 体验优化功能，支持进入游戏关闭自动亮度、三指截图、护眼模式",
              "en-us": "New: Optimized gaming experience: auto brightness, screenshot gestures, and Reading mode can be turned off automatically during games."
            },
            {
              "zh-cn": "优化 游戏工具箱呼出方式调整为顶部侧边划出",
              "en-us": "Optimization: You can open the gaming toolbox by swiping from the top side of the screen"
            }
          ]
        },
        {
          "zh-cn": "安全中心",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复 红包助手战绩分享失败的问题",
              "en-us": ""
            },
            {
              "zh-cn": "小米钱包】(小米8/小米MIX 3/小米8屏幕指纹版/小米8透明探索版)",
              "en-us": ""
            },
            {
              "zh-cn": "优化 小米公交卡片异常提示的用户体验",
              "en-us": ""
            },
            {
              "zh-cn": "修复 银联“碰一碰”支付付款页面加载不出来的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 Mi Pay在线支付限额无返回数据的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 双击电源键未能调出Mi Pay银行卡的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 小米公交充值支付界面一直存在“正在加载”对话框的问题",
