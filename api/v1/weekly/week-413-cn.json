  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "已加入防回刷机制的机型无法降级刷回旧版本的开发版或稳定版，否则会导致手机变砖",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可进入“设置→我的设备→MIUI版本”在线升级",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户，建议通过线刷升级至 MIUI 10开发版，教程请见下方“刷机指南”",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI10 开发版 9.4.18 部分机型延迟发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米6因适配Android P，4月12日发布最后一个基于Android O的公测开发版9.4.11，预计4月底启动Android P内测，适配期间将暂停更新推送",
          "en-us": ""
        },
        {
          "zh-cn": "小米9 SE已发布Android P公测开发版9.4.18",
          "en-us": ""
        },
        {
          "zh-cn": "小米9已发布公测开发版",
          "en-us": ""
        },
        {
          "zh-cn": "因测试系统稳定性，小米6X、小米8 SE本周暂停公测",
          "en-us": ""
        },
        {
          "zh-cn": "红米部分机型开发版升级策略调整",
          "en-us": ""
        },
        {
          "zh-cn": "Android P机型招募开发版内测米粉",
          "en-us": ""
        },
        {
          "zh-cn": "重要提示：同时装有 Google 和 MIUI 安装器，并且已在开发者模式中开启“MIUI 优化”的用户，请勿进行关闭操作，否则可能会出现循环重启问题。",
          "en-us": ""
        },
        {
          "zh-cn": "五一假期将至，4月28日暂停内测、公测更新发布。5月6日起恢复内测更新、公测发布。",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9开发版可点击“设置”→“我的设备”→“MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "MIUI 6/7/8/9稳定版用户版本用户建议通过线刷升级，线刷会清除全部数据",
          "en-us": ""
        },
        {
          "zh-cn": "开发版/稳定版相互刷机时，需备份好重要数据，再通过线刷方式清除所有数据进行刷机，防止出现异常问题",
          "en-us": ""
        },
        {
          "zh-cn": "新机型有防刷机保护，线刷前请先进行 Bootloader 解锁",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第413周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "锁屏、状态栏、通知栏",
          "en-us": "Lockscreen, Status Bar, Notification Bar",
          "changes": [
            {
              "zh-cn": "优化 切换手机分身时，提升壁纸的加载速度",
              "en-us": "Optimization: Wallpaper loads faster in Second space now"
            },
            {
              "zh-cn": "优化 指纹解锁体验：通过双击通知消息等方式解锁手机时，可优先使用指纹（而不是密码）进行解锁",
              "en-us": "Optimization: More fingerprint unlock options (e.g. through a Lock screen notification) are available now"
            },
            {
              "zh-cn": "修复 密码界面人脸解锁成功后动画不流畅的问题",
              "en-us": "Fix: Face unlock animation didn't work properly"
            },
            {
              "zh-cn": "修复 息屏设置页面，双时钟预览图数字折行的问题",
              "en-us": "Fix: Issues with overlapping in Dual Clock settings"
            },
            {
              "zh-cn": "修复 状态栏电池电量刷新不及时问题",
