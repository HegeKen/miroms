  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI 开发版可进入“设置—>我的设备—>MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI 12.5 开发版 21.11.3 版本 今天陆续发布，部分机型已发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米10S 首次发布安卓12开发版公测，多项优化与改进, 向勇敢尝鲜的米粉们致敬",
          "en-us": ""
        },
        {
          "zh-cn": "由于Android大版本升级，小米MIX 4、Redmi K40 游戏增强版、Redmi Note 10 Pro 2021年10月29日起暂停发布公测，在内测周度参与标准中，大家可对正在使用的版本投票和发布体验贴，感谢大家的理解",
          "en-us": ""
        },
        {
          "zh-cn": "由于Android大版本升级，Xiaomi Civi、小米10Pro、小米10、Redmi K30 Pro、小米10 至尊纪念版、Redmi K30S 至尊纪念版 2021年11月12日起暂停发布公测，在内测周度参与标准中，大家可对正在使用的版本投票和发布体验贴，感谢大家的理解",
          "en-us": ""
        },
        {
          "zh-cn": "开发版内测版本问题逐步修复后，会陆续推送开发版公测版本，安卓12已知问题，",
          "en-us": ""
        },
        {
          "zh-cn": "点此查看>>",
          "en-us": ""
        },
        {
          "zh-cn": "2021年11月27日起，以下机型将停止开发版内测公测：小米9、小米9SE、Redmi K20 Pro、Redmi K20、小米CC9 美图定制版、Redmi Note 8 Pro、小米CC9、Redmi Note 8、小米9 Pro",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第520周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复趣味拟物设置界面显示两个标题的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复下拉通知再上滑进入密码页，手势返回页面空白或高斯模糊的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复部分机型解锁时出现闪屏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复偶现锁屏输入密码页面卡顿的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复在锁屏界面无卡情况下，拨打紧急电话后无法正常进入桌面的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复横屏下锁屏设置页页面闪烁的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复无障碍模式下通知栏“更多设置”按钮无播报的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复双开应用收到通知时，通知栏没有显示双开应用图标的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "自由窗口",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增智能工具箱，支持应用以小窗形态开启「开启路径：设置-特色功能-智能工具箱」",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "状态栏、通知栏",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复锁屏时无法下拉通知栏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复下拉通知栏松手后，回弹时第一条通知顶部显示不全的问题（小米11、小米11Ultra）",
              "en-us": ""
            },
            {
              "zh-cn": "修复锁屏状态下启动相机，下拉通知栏点击通知后，图案解锁页面无法向左滑动的问题（小米11、小米11Ultra）",
              "en-us": ""
            },
            {
              "zh-cn": "修复无障碍模式下通知栏“更多设置”按钮无播报的问题（小米11、小米11Ultra）",
              "en-us": ""
            },
            {
              "zh-cn": "修复双开应用收到通知时，通知栏没有显示双开应用图标的问题（小米11、小米11Ultra）",
              "en-us": ""
            },
            {
              "zh-cn": "修复系统语言为藏语/维语时，通知栏模态菜单显示错乱的问题（小米11、小米11Ultra）",
              "en-us": ""
            },
            {
              "zh-cn": "优化闹钟提醒通知的展示（小米11、小米11Ultra）",
              "en-us": ""
            },
            {
              "zh-cn": "修复勿扰模式的提醒通知在锁屏界面显示位置偏下的问题（小米11、小米11Ultra）",
              "en-us": ""
            },
            {
              "zh-cn": "修复长按通知偶现权限弹窗重叠的异常",
              "en-us": ""
            },
            {
              "zh-cn": "修复抬起亮屏时偶现锁屏通知抖动的异常",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "相机",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复特定场景下相机中魔法分身闪退的问题（Redmi K30 至尊纪念版、Redmi 10X、Redmi 10X Pro）",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "小米相册",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增地图相册，支持地图上查看图像",
              "en-us": ""
            },
            {
              "zh-cn": "新增照片整理模块，整理更便捷高效",
