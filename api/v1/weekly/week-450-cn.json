  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI 11开发版可进入“设置—>我的设备—>MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI11 开发版 20.3.19 11:00发布，部分机型延迟发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米MIX 2S、Redmi K30 5G、Redmi K30、Redmi Note 8 Pro 因测试系统稳定性，公测发布延迟",
          "en-us": ""
        },
        {
          "zh-cn": "20.3.19版本设置中的MIUI实验室和游戏加速无法正常进入，临时解决方案：使用设置上方的搜索功能，搜索MIUI实验室或游戏加速进入，我们将在下个版本修复此问题，感谢大家的理解",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第450周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "超级省电",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 超级省电优化项：抬起唤醒、灭屏指纹等",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 更新谷歌安全补丁（2020#03），提升系统安全性",
              "en-us": ""
            },
            {
              "zh-cn": "优化 同一页面发生横竖屏旋转时的动画效果（小米9、Redmi K20 Pro）",
              "en-us": ""
            },
            {
              "zh-cn": "修复 系统休眠时无法点亮指纹图标问题（小米CC9美图定制版、小米CC9）",
              "en-us": ""
            },
            {
              "zh-cn": "修复 修复桌面无法滑动问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "状态栏、通知栏",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 仅在WiFi6情况下显示技术标准角标（小米10、小米10 Pro）",
              "en-us": ""
            },
            {
              "zh-cn": "修复 全局反色下状态栏显示异常的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "相机",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 拍照文档模式 支持自动裁切、黑白，增强效果处理以及自动消除阴影功能(小米手机9、小米手机9Pro 5G、小米CC9 Pro)",
              "en-us": ""
            },
            {
              "zh-cn": "优化 相机连拍速度（小米10 Pro）",
              "en-us": ""
            },
            {
              "zh-cn": "修复 偶现稳定性问题（小米10、小米10 Pro）",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "屏幕时间管理",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 设备连续使用提醒",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "设置",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "全新视频工具箱上线，支持息屏听剧、应用悬浮窗等功能",
              "en-us": ""
            },
            {
              "zh-cn": "可前往「设置 - 特色功能 - 视频工具箱」调整设置",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "授权管理",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 状态栏权限标识支持添加白名单，添加白名单的应用将不会显示相关权限标识【应用行为记录-设置】",
              "en-us": ""
            },
            {
              "zh-cn": "新增 剪切板权限，防止应用私自读取或篡改剪切板内容",
              "en-us": ""
            },
            {
              "zh-cn": "新增 定位/录音/拍照/联系人/通话记录/日历/读写外部储存等多个权限支持设置为“仅在使用中允许”",
              "en-us": ""
            },
            {
              "zh-cn": "新增 定位/录音/拍照权限支持设置“允许本次”",
              "en-us": ""
            },
            {
              "zh-cn": "新增 全面禁止后台相机权限，根除恶意应用偷窥行为",
              "en-us": ""
            },
            {
              "zh-cn": "新增 定位/录音/拍照权限根据权限描述显示授权选项功能",
              "en-us": ""
            },
            {
              "zh-cn": "优化 敏感行为通知显示频率，减少通知次数",
              "en-us": ""
            },
            {
              "zh-cn": "修复 因敏感行为通知频繁发送导致的无法息屏问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 状态栏权限标识无法点击的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 部分版本中，权限标识添加白名单后，标识没有立即消失的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 权限标识出现时删除对应应用，导致标识无法消失的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "网络助手",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 多种网络诊断可修复内容",
              "en-us": ""
            }
          ]
        }
      ]
    }
  ]
}