  "logs": [
    {
      "zh-cn": "第498周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复录入指纹重启手机后，指纹异常闪高亮问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复音量调节后，右侧音量条不自动消失的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复日历、天气图标显示错误的问题",
              "en-us": ""
            },
            {
              "zh-cn": "优化通知提醒页面加载速度",
              "en-us": ""
            },
            {
              "zh-cn": "修复不能自动退出深色模式的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复小米10 切换深色模式卡顿的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复深色模式部分APP不生效的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复计时器与高能时刻悬浮窗位置冲突",
              "en-us": ""
            },
            {
              "zh-cn": "修复指纹动画导致的崩溃问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复解锁后指纹图标依旧可点击，并显示动画震动的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复修改字体大小后，重设数字密码位数不更新、恢复出厂设置后弹出PIN码又消失的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复人脸解锁后停留在锁屏时，使用错误指纹解锁无法进入系统问题（仅在后置指纹机型）",
              "en-us": ""
            },
            {
              "zh-cn": "修复全屏界面灭屏，指纹解锁花屏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复点击跳转到密码页面时，没有显示“点击重试”提示文案的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复蓝牙解锁成功后，使用错误人脸解锁跳转到密码页面，直接解锁的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复指纹动画导致的崩溃问题，横屏下灭屏再亮屏后，指纹解锁光斑位置异常无法解锁的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复部分场景下自由小窗卡死的问题（小米11青春版、小米10）",
              "en-us": ""
            }
          ]
        },
