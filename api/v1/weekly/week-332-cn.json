  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI V5 / MIUI 6 / MIUI 7开发版可通过“系统更新”APP 检测升级，升级前务必备份重要数据；",
          "en-us": ""
        },
        {
          "zh-cn": "开发版/稳定版相互卡刷时，需备份好重要数据，再进入“系统更新”清除数据卡刷完整包，防止出现异常问题；",
          "en-us": ""
        },
        {
          "zh-cn": "新机型有防刷机保护，线刷前请先进行Bootloader解锁",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI8 7.5.11 已发布！",
          "en-us": ""
        },
        {
          "zh-cn": "小米MIX、小米Note 2、小米手机5s、小米手机5s Plus 因适配 Android 7.0，5月12日发布 Android 6.0 的最后一个公测开发版7.5.11。5月15日起进入内测阶段，预计需要三周时间进行内测修复/优化。公测时间根据内测版本完善情况而定，敬请周知。",
          "en-us": ""
        },
        {
          "zh-cn": "红米Note 4、红米Note 4X 高配已发布7.5.11。",
          "en-us": ""
        },
        {
          "zh-cn": "小米手机6因测试卡刷包稳定性，本周仅发布线刷包。已是开发版的米粉可通过 OTA 升级，稳定版刷开发版暂仅支持线刷方式升级。线刷需要清除数据再刷机，否则可能出现无法拨打电话等不兼容现象，请务必备份好重要数据到云服务或电脑里，点此下载线刷包。首次刷机的小伙伴，请严格按照刷机教程进行刷机，查看刷机教程，小米手机6为有 BL 锁机型，线刷需要先解锁。",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第332周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 微信指纹支付功能（暂仅支持小米手机6）",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "锁屏、状态栏、通知栏",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复 某些情况下，亮度条位置不正确的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复 某些情况下，通知栏出现白块的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "主屏幕",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 最近任务默认不显示内存信息，可前往「设置－桌面与最近任务」开启",
              "en-us": ""
            },
            {
              "zh-cn": "优化 「最近任务」一键清理的动画效果",
              "en-us": ""
            },
            {
              "zh-cn": "修复 某些情况下，最近任务不消失的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "音乐",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复 某些本地歌曲添加到自建歌单无法播放的问题",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "天气",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "新增 空气质量预报改版，升级至48小时、15天预报，并新增健康建议、污染物科普、地图模式",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "应用商店",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "优化 “应用卸载页”中应用使用频率的计算策略",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "小米钱包",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复 概率性无法显示公交卡列表的问题",
              "en-us": ""
            }
          ]
        }
      ]
    }
