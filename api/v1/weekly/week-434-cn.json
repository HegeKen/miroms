    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI11 开发版9.10.24 11:00发布，部分机型延迟发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米8屏幕指纹版、小米MIX 2S、小米8透明探索版、小米MIX 3 发布第一个基于Android 10 的 MIUI 开发版, 多项优化与改进, 向勇敢尝鲜的米粉们致敬!",
          "en-us": ""
        },
        {
          "zh-cn": "小米8 SE、小米9 SE、小米8 启动Android 10升级，本周暂停发布",
          "en-us": ""
        },
        {
          "zh-cn": "小米PLAY、小米9 Pro 5G 因测试系统稳定性，公测发布延迟",
          "en-us": ""
        },
        {
          "zh-cn": "Redmi Note 8 Pro 因测试系统稳定性，本周暂停发布",
          "en-us": ""
        },
        {
          "zh-cn": "红米Note 4X 、红米4X、红米Note 5A标准版、红米Note 5A高配版、小米5C、小米Max 2、小米Note 2、小米MIX、小米手机5s、小米手机5s Plus 、红米5 Plus、小米5X、红米5A、红米5、小米平板3 正式停止开发版公测",
          "en-us": ""
        },
        {
          "zh-cn": "由于不在MIUI11适配计划机型内，小米平板4/4Plus暂停更新",
          "en-us": ""
        }
      ]
    }
