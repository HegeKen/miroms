  "addons": [
    {
      "zh-cn": "升级说明",
      "en-us": "Update instruction",
      "details": [
        {
          "zh-cn": "MIUI 开发版可进入“设置—>我的设备—>MIUI版本”在线升级，升级前务必备份重要数据",
          "en-us": ""
        },
        {
          "zh-cn": "部分机型可能因功能进版时间略有差异，具体功能请以手机端展示日志为准",
          "en-us": ""
        }
      ]
    },
    {
      "zh-cn": "版本说明",
      "en-us": "Version Information",
      "details": [
        {
          "zh-cn": "MIUI 12.5 开发版21.6.23 版本 今天陆续发布，部分机型已发布",
          "en-us": ""
        },
        {
          "zh-cn": "Redmi Note 10 Pro 发布基于MIUI12.5的开发版, 多项优化与改进, 向勇敢尝鲜的米粉们致敬",
          "en-us": ""
        },
        {
          "zh-cn": "由于正在修复分身空间小米视频无法使用的问题，小米11 Ultra、小米11 Pro 预计明日24点前发布，感谢大家的理解",
          "en-us": ""
        },
        {
          "zh-cn": "由于正在修复特定场景下，无法使用的问题，小米9 本周暂停发布，感谢大家的理解",
          "en-us": ""
        },
        {
          "zh-cn": "2021年5月2日起，如出现灌水希望增加内测分行为，会非常大降低内测通过机率，好的氛围需要大家一起维护，感谢大家的理解",
          "en-us": ""
        }
      ]
    }
  ],
  "logs": [
    {
      "zh-cn": "第501周开发版日志",
      "en-us": "",
      "log": [
        {
          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复淘宝、微博APP部分场景下卡顿的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复个别应用在使用指纹验证时，跳回到锁屏界面的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复深色模式下应用商店显示斑马线的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复部分场景下拨打电话，没有过渡动画的问题",
              "en-us": ""
            },
            {
              "zh-cn": "增加应用内刘海设置",
              "en-us": ""
            },
            {
              "zh-cn": "修复状态栏信号图标间距较大的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复天气城市列表滑动掉帧的问题（小米10）",
              "en-us": ""
            },
            {
              "zh-cn": "优化背部轻敲功能，解决了部分灵敏度问题（Redmi K40 Pro）",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "状态栏、通知栏",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复通知点击延时提醒后出现的闪屏问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复透明背景悬浮通知显示重叠",
              "en-us": ""
            },
            {
              "zh-cn": "修复通知中心下拉失效的问题",
              "en-us": ""
            },
            {
              "zh-cn": "优化来电的悬浮通知屏蔽逻辑",
              "en-us": ""
            },
            {
              "zh-cn": "优化组通知展开收起的动画",
              "en-us": ""
            },
            {
              "zh-cn": "修复通知滑动时的圆角展示异常",
              "en-us": ""
            },
            {
              "zh-cn": "优化通知栏深色模式显示",
              "en-us": ""
            }
          ]
        },
        {
          "zh-cn": "录音机",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复一些已知问题，提升应用稳定性",
