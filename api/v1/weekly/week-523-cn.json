          "zh-cn": "系统",
          "en-us": "",
          "changes": [
            {
              "zh-cn": "修复调节音量时，部分场景自动锁屏的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复偶现全面屏上滑手势失效的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复偶现快捷手势无法使用的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复快速点击锁屏签名后，弹窗背景异常的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复选择锁屏时间样式界面，时间和日期间隔较大的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复输入PIN码后需要指纹解锁两次的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复部分机型解锁失败的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复部分场景下解锁界面闪现的问题",
              "en-us": ""
            },
            {
              "zh-cn": "修复输入密码界面未主动弹出的问题",
              "en-us": ""
            },
            {
